# Postgres connection string for the self-hosted DB.
DATABASE_URL="postgresql://kilocal:kilocal@localhost:5432/kilocal"

# Random 32-byte secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me"

# Public URL the API is reachable at. Better-Auth uses this to build callback URLs.
BETTER_AUTH_URL="http://localhost:3000"

# Port the Hono server listens on.
PORT=3000

NODE_ENV=development
