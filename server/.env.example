# Kilocal API — environment template.
# Copy to a local .env (gitignored) and fill in values.

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database ---
# Postgres connection string for the self-hosted DB.
DATABASE_URL="postgresql://kilocal:kilocal@localhost:5432/kilocal"

# --- Better Auth core ---
# Random 32-byte secret. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET="replace-me"
# Public URL the API is reachable at. Better-Auth uses this to build callback URLs.
# On a physical device for dev, use your machine's LAN IP so the device can reach it.
BETTER_AUTH_URL="http://localhost:3000"
# Comma-separated extra trusted origins. The defaults (kilocal://, exp://,
# https://appleid.apple.com) are always included.
TRUSTED_ORIGINS=

# --- Email OTP delivery (Resend) ---
# If unset, OTPs are logged to server stdout so you can develop without Resend.
RESEND_API_KEY=
RESEND_FROM="Kilocal <noreply@kilocal.app>"

# --- Apple Sign-In (optional — leave empty to disable the provider) ---
# APPLE_CLIENT_ID is the Services ID from Apple Developer (NOT the iOS bundle ID).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# .p8 file contents. Escape newlines as \n on a single line, or paste raw on
# multiple lines if your secret manager preserves them.
APPLE_PRIVATE_KEY=
# iOS bundle ID — recommended when using native idToken sign-in from Expo.
APPLE_APP_BUNDLE_IDENTIFIER="com.kepler.kilocal"
