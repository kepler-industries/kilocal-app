# Kilocal mobile — environment template
# Copy to .env (gitignored). Only EXPO_PUBLIC_* vars are inlined into the JS
# bundle at build time; everything else is ignored on the client.

# Backend API base URL. On a physical device use your machine's LAN IP so the
# device can reach the server (e.g. http://192.168.1.20:3000). On the iOS
# simulator http://localhost:3000 works.
EXPO_PUBLIC_API_URL=http://localhost:3000
